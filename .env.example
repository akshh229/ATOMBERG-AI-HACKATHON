NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local scripts only. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Microsoft Entra / Graph org sync.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_EMPLOYEE_GROUP_ID=
ENTRA_MANAGER_GROUP_ID=
ENTRA_ADMIN_GROUP_ID=

# Optional notification dispatch.
TEAMS_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Optional Playwright/local fallback override.
NEXT_PUBLIC_ALIGNHQ_FORCE_LOCAL_DEMO=false

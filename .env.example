ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_EMPLOYEE_GROUP_ID=
ENTRA_MANAGER_GROUP_ID=
ENTRA_ADMIN_GROUP_ID=

# Optional notification dispatch.
TEAMS_WEBHOOK_URL=
TEAMS_WEBHOOK_ALLOWLIST=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
EMAIL_WEBHOOK_ALLOWLIST=
WEBHOOK_HMAC_SECRET=
DISPATCH_MAX_RETRIES=2

# Optional Playwright/local fallback override.
NEXT_PUBLIC_ALIGNHQ_FORCE_LOCAL_DEMO=false
